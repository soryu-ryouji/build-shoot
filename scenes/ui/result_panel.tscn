[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/result_panel.gd" id="1_result"]

[node name="ResultPanel" type="PanelContainer"]
process_mode = 3
visible = false
script = ExtResource("1_result")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 22
theme_override_constants/margin_top = 22
theme_override_constants/margin_right = 22
theme_override_constants/margin_bottom = 22

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TitleLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.0901961, 0.0980392, 0.105882, 1)
theme_override_font_sizes/font_size = 30
horizontal_alignment = 1

[node name="DetailLabel" type="Label" parent="Margin/Column"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.376471, 0.403922, 0.419608, 1)
theme_override_font_sizes/font_size = 16
horizontal_alignment = 1

[node name="Actions" type="HBoxContainer" parent="Margin/Column"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="RestartButton" type="Button" parent="Margin/Column/Actions"]
custom_minimum_size = Vector2(240, 54)
layout_mode = 2
size_flags_horizontal = 3
text = "重新开始"

[node name="MenuButton" type="Button" parent="Margin/Column/Actions"]
custom_minimum_size = Vector2(240, 54)
layout_mode = 2
size_flags_horizontal = 3
text = "返回主界面"

[connection signal="pressed" from="Margin/Column/Actions/RestartButton" to="." method="_on_restart"]
[connection signal="pressed" from="Margin/Column/Actions/MenuButton" to="." method="_on_menu"]
